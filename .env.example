DEBUG=True
ALLOWED_HOSTS=*

MAX_UPLOAD_SIZE_MB=5
MAX_FILES_PER_REQUEST=3
DOCUMENT_TIMEOUT_SECONDS=30
RAW_TEXT_PREVIEW_LENGTH=300

# local or remote
LLM_PROVIDER=remote

# remote backend: openai or anthropic or groq
REMOTE_LLM_BACKEND=openai
REMOTE_MODEL=gpt-4.1-mini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# local (ollama)
LOCAL_MODEL=llama3.1
OLLAMA_URL=http://localhost:11434/api/generate
